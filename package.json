{
  "name": "text-games",
  "version": "0.9.27",
  "description": "文字游戏集合（进化史、进化点击、兵阵对决、斗气苍穹等）",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "npm run build:xian && tsx watch src/server.ts",
    "build:xian": "esbuild xian/src/game/browser.ts --bundle --outfile=xian/public/engine.js --format=iife --platform=browser --target=es2020",
    "build": "npm run build:xian && tsc",
    "start": "node dist/src/server.js"
  },
  "keywords": [
    "text-game",
    "evolution",
    "incremental",
    "cultivation",
    "autochess",
    "typescript",
    "collection"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
