{
  "name": "evolve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evolve - an incremental evolution game where you grow a single cell into a thinking being.",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build": "tsc -b && vite build",
